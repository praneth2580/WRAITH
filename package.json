{
  "name": "wraithjs",
  "version": "0.1.0-beta.0",
  "description": "Web scraping and browser automation with human-like behaviour and optional AI, all running in your own process.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx",
    "devtools": "tsx devtools/server.ts",
    "publish:beta": "npm publish --tag beta",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "scraping",
    "web-scraping",
    "automation",
    "playwright",
    "crawler",
    "human",
    "ai",
    "llm",
    "ollama",
    "anthropic",
    "openai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praneth2580/WRAITH.git"
  },
  "license": "MIT",
  "dependencies": {
    "@duckduckgo/autoconsent": "^17.3.0",
    "cheerio": "^1.2.0",
    "node-html-markdown": "^2.0.0",
    "p-queue": "^9.3.5",
    "p-retry": "^7.1.1",
    "playwright": "^1.64.1",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.4.0",
    "openai": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "openai": "^6.49.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
